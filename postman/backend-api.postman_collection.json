  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const requestName = pm.info.requestName;",
          "const method = pm.request.method;",
          "const expectedStatus = requestName.startsWith('Delete ') ? 204 : (method === 'POST' ? 201 : 200);",
          "pm.test(requestName + ' responde con el estado esperado', function () {",
          "  pm.expect(pm.response.code).to.eql(expectedStatus);",
          "});",
          "if (expectedStatus !== 204) {",
          "const rawBody = pm.response.text();",
          "pm.test(requestName + ' devuelve JSON valido', function () {",
          "  pm.expect(rawBody).to.not.be.empty;",
          "});",
          "let data;",
          "try {",
          "  data = pm.response.json();",
          "} catch (error) {",
          "  pm.test(requestName + ' parsea como JSON', function () {",
          "    throw error;",
          "  });",
          "}",
          "if (Array.isArray(data)) {",
          "  pm.test(requestName + ' devuelve una lista', function () {",
          "    pm.expect(data).to.be.an('array');",
          "  });",
          "}",
          "switch (requestName) {",
          "  case 'Create role':",
          "    if (data.id_role !== undefined) pm.environment.set('id_role', data.id_role);",
          "    break;",
          "  case 'Create user':",
          "    if (data.id_user !== undefined) pm.environment.set('id_user', data.id_user);",
          "    break;",
          "  case 'Create career':",
          "    if (data.id_career !== undefined) pm.environment.set('id_career', data.id_career);",
          "    break;",
          "  case 'Create subject':",
          "    if (data.id_subject !== undefined) pm.environment.set('id_subject', data.id_subject);",
          "    break;",
          "  case 'Create period':",
          "    if (data.id_period !== undefined) pm.environment.set('id_period', data.id_period);",
          "    break;",
          "  case 'Create teacher':",
          "    if (data.id_teacher !== undefined) pm.environment.set('id_teacher', data.id_teacher);",
          "    break;",
          "  case 'Create student':",
          "    if (data.id_student !== undefined) pm.environment.set('id_student', data.id_student);",
          "    break;",
          "  case 'Create section':",
          "    if (data.id_section !== undefined) pm.environment.set('id_section', data.id_section);",
          "    break;",
          "  case 'Create registration':",
          "    if (data.id_registration !== undefined) pm.environment.set('id_registration', data.id_registration);",
          "    break;",
          "  case 'Create registration detail':",
          "    if (data.id_detail !== undefined) pm.environment.set('id_registration_detail', data.id_detail);",
          "    break;",
          "  case 'Create pensum':",
          "    if (data.id_pensum !== undefined) pm.environment.set('id_pensum', data.id_pensum);",
          "    break;",
          "  case 'Create pensum subject':",
          "    if (data.id_pensum_subject !== undefined) pm.environment.set('id_pensum_subject', data.id_pensum_subject);",
          "    break;",
          "  case 'Create prerequisite':",
          "    if (data.id_prerequisite !== undefined) pm.environment.set('id_prerequisite', data.id_prerequisite);",
          "    break;",
          "  case 'Create audit log':",
          "    if (data.id_log !== undefined) pm.environment.set('id_audit_log', data.id_log);",
          "    break;",
          "  case 'Create document request':",
          "    if (data.id_request !== undefined) pm.environment.set('id_document_request', data.id_request);",
          "    break;",
          "}",
          "if (requestName.startsWith('List ')) {",
          "  pm.test(requestName + ' retorna un arreglo', function () {",
          "    pm.expect(data).to.be.an('array');",
          "  });",
          "}",
          "}"
        ]
      }
    }
