  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const requestName = pm.info.requestName;",
          "const method = pm.request.method;",
          "const explicitExpected = {",
          "  'Login': 200,",
          "  'Forgot password': 200,",
          "  'Reset password': 200,",
          "  'Me': 200,",
          "  'Get profile': 200,",
          "  'Update profile': 200,",
          "  'Change password': 200,",
          "  'Issue token': 201",
          "};",
          "const defaultByMethod = { GET: 200, POST: 201, PUT: 200, DELETE: 204 };",
          "const expectedStatus = explicitExpected[requestName] ?? defaultByMethod[method] ?? 200;",
          "pm.test(requestName + ' responde con status esperado', function () {",
          "  pm.expect(pm.response.code).to.eql(expectedStatus);",
          "});",
          "",
          "if (requestName === 'Login') {",
          "  const body = pm.response.json();",
          "  if (body.access_token) pm.collectionVariables.set('accessToken', body.access_token);",
          "}",
          "",
          "if (pm.response.code !== 204) {",
          "  let data = null;",
          "  try {",
          "    data = pm.response.json();",
          "    pm.test(requestName + ' retorna JSON valido', function () {",
          "      pm.expect(data).to.not.equal(undefined);",
          "    });",
          "  } catch (error) {",
          "    pm.test(requestName + ' debe retornar JSON valido', function () { throw error; });",
          "  }",
          "",
          "  if (Array.isArray(data) && requestName.startsWith('List')) {",
          "    pm.test(requestName + ' retorna arreglo', function () {",
          "      pm.expect(data).to.be.an('array');",
          "    });",
          "  }",
          "",
          "  const idKeys = [",
          "    'id_role', 'id_user', 'id_career', 'id_subject', 'id_period', 'id_semester',",
          "    'id_teacher', 'id_student', 'id_section', 'id_registration', 'id_detail',",
          "    'id_pensum', 'id_pensum_subject', 'id_prerequisite', 'id_log', 'id_request',",
          "    'id_state', 'id_municipality', 'id_parish', 'id_pre', 'id_doc'",
          "  ];",
          "",
          "  if (data && typeof data === 'object' && !Array.isArray(data)) {",
          "    idKeys.forEach((key) => {",
          "      if (data[key] !== undefined && data[key] !== null) pm.collectionVariables.set(key, String(data[key]));",
          "    });",
          "  }",
          "}"
        ]
      }
    }
