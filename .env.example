# App
NODE_ENV=development
PORT=3000

# DB switching: set to 'local' or 'remote'
DB_ENV=local

# Local DB (used when DB_ENV=local)
DB_HOST_LOCAL=ep-late-dawn-amfa1yoq.c-5.us-east-1.aws.neon.tech
DB_PORT_LOCAL=5432
DB_NAME_LOCAL=neondb
DB_USER_LOCAL=neondb_owner
DB_PASS_LOCAL=npg_mQJPol4s3AUR

# Remote DB URI (used when DB_ENV=remote). Example: postgresql://user:pass@host:port/dbname
DB_URI_REMOTE=

# JWT
JWT_SECRET=change_this_secret
PASSWORD_RESET_TOKEN_EXPIRES_IN=30m

# Email
# EMAIL_TRANSPORT=log solo imprime en consola; smtp envia correos reales
EMAIL_TRANSPORT=log
EMAIL_FROM=no-reply@example.com
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Redis (cache layer - optional, app works without it)
REDIS_ENABLED=false
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Frontend
FRONTEND_URL=http://localhost:5173
